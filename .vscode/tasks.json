{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "hotel: start server",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^(?:npm ERR!|Error:)(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*npm run dev.*",
                    "endsPattern": ".*Hotel management app is running at http://localhost:3000.*"
                }
            }
        }
    ]
}