{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "hotel: ensure Python server",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\ensure-server.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "instanceLimit": 1,
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        }
    ]
}